# Copy this file to .env and fill in your own values.
# Never commit .env or a real API key.

# ---------------------------------------------------------------------------
# Provider selection (one place, no code changes)
# ---------------------------------------------------------------------------
# gemini            = Google Gemini through the google-genai SDK (default)
# openai-compatible = OpenAI itself, LM Studio, Ollama, vLLM, Groq, OpenRouter
LLM_PROVIDER=gemini

# Model name. Any model that supports function/tool calling works.
LLM_MODEL=gemini-3.5-flash-lite

# API key for the selected provider. For Gemini this is a Google AI Studio key.
LLM_API_KEY=

# Only for LLM_PROVIDER=openai-compatible with a local server. Leave empty for
# the official OpenAI API.
# LLM_BASE_URL=http://localhost:1234/v1

# ---------------------------------------------------------------------------
# Local OpenAI-compatible examples (uncomment the whole block you need)
# ---------------------------------------------------------------------------
# LM Studio:
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=qwen3-8b
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
#
# Ollama:
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=qwen3:8b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
#
# OpenRouter (a free API model, for example):
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-openrouter-key

# Old names still work when LLM_MODEL / LLM_API_KEY are not set:
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=

# Optional overrides (defaults are correct for the assignment).
# CITYWHEELS_DATA_DIR=
# CITYWHEELS_NOW=2026-06-10T09:00:00+02:00
